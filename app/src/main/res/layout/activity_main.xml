<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pageBg">

    <!-- Dark top bar, PuzzCombo style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/topBar"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:contentDescription="back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Max Combo"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pageBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initialize"
                android:textColor="@color/textTitle"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未开启。先授予悬浮窗权限，再点「开启助手」允许屏幕录制。"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目标模式"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/targetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="计算量"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/levelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="各色优先（無効 / 並 / 優先）"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <!-- Per-colour priority sliders: 0=無効 1=並 2=優先 -->
            <LinearLayout android:id="@+id/priorityRowFire" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="火" android:textColor="#E05548" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityFire" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/priorityRowWater" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="水" android:textColor="#4A90E2" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityWater" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/priorityRowWood" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="木" android:textColor="#66C266" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityWood" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/priorityRowLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="光" android:textColor="#F0D048" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityLight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/priorityRowDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="闇" android:textColor="#9E58C8" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityDark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/priorityRowHeart" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="心" android:textColor="#F08098" android:textSize="15sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/priorityHeart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="2" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="計算量（高速 ←→ 高品質）"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/qualityBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="2" android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="移動（少なめ ←→ 多め）"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <SeekBar android:id="@+id/moveBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="2" android:layout_marginBottom="8dp" />

            <CheckBox android:id="@+id/attackCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全体攻撃（优先整排大量消）" android:textColor="@color/textBody" android:textSize="15sp" />
            <CheckBox android:id="@+id/comboCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="コンボ優先（优先最大连击，默认）" android:textColor="@color/textBody" android:textSize="15sp" android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="路线透明度"
                android:textColor="@color/textTitle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/alphaBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="175"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开启后，游戏内右上角只会留一个极小「分析」钮：点它抓帧识别盘面，再照着路线拖珠。"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/toggleBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_gray"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textSize="16sp"
                android:padding="14dp"
                android:stateListAnimator="@null"
                android:elevation="2dp"
                android:layout_marginBottom="12dp"
                android:text="开启助手" />

            <TextView
                android:id="@+id/btnHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="说明 / FAQ"
                android:textColor="@color/textLink"
                android:textSize="16sp"
                android:padding="8dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:text="使用顺序：&#10;1. 打开 P&amp;D，进到要转珠的那一回合。&#10;2. 点「开启助手」，允许通知与屏幕录制授权。&#10;3. 悬浮栏选目标、计算量，点「分析」抓帧，照路线拖珠。&#10;&#10;注意：识别靠颜色，不同主题/机型可能要微调参考色；天空掉落随机，路线只算你这一步能确定的 combo。这是外部辅助工具，不读游戏内存、不注入，账号风险自担。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
