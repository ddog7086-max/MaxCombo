<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pageBg">

    <!-- Dark top bar, PuzzCombo style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/topBar"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:contentDescription="back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Max Combo"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pageBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initialize"
                android:textColor="@color/textTitle"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未开启。先授予悬浮窗权限，再点「开启助手」允许屏幕录制。"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <com.example.maxcombo.overlay.RouteBoardView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#1A000000"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开启后，直接拖动悬浮框对准 6x5 珠阵；框住珠子即可，无需精确。在预览图上点一格可手设起点。"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/toggleBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_gray"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textSize="16sp"
                android:padding="14dp"
                android:stateListAnimator="@null"
                android:elevation="2dp"
                android:layout_marginBottom="12dp"
                android:text="开启助手" />

            <TextView
                android:id="@+id/btnHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="说明 / FAQ"
                android:textColor="@color/textLink"
                android:textSize="16sp"
                android:padding="8dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/textBody"
                android:textSize="15sp"
                android:text="使用顺序：&#10;1. 打开 P&amp;D，进到要转珠的那一回合。&#10;2. 点「开启助手」，允许通知与屏幕录制授权。&#10;3. 悬浮栏选目标、计算量，点「分析」抓帧，照路线拖珠。&#10;&#10;注意：识别靠颜色，不同主题/机型可能要微调参考色；天空掉落随机，路线只算你这一步能确定的 combo。这是外部辅助工具，不读游戏内存、不注入，账号风险自担。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
